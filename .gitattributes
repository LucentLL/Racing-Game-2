*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
# H1268: the 50-family engine pack ships as Ogg Vorbis (31 MB encoded from
# 262 MB of source WAV). Same LFS treatment as the wavs — pages.yml keys its
# LFS object cache off `git lfs ls-files`, so these ride that cache too.
*.ogg filter=lfs diff=lfs merge=lfs -text
